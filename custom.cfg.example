[buildout]
extends = buildout.cfg

# debug options
#version = noversions
#log-level = DEBUG

[settings]
#hostname = localhost
#http-port = 8081
#https-port = 8443
#log-level = WARN
# Gunicorn sizing
#gunicorn-workers = 4
#gunicorn-threads = 4
#gunicorn-timeout = 30

## deployment options
#prefix =  /opt/birdhouse
#user = www-data
#etc-user = root
#group = nobody

# theme
phoenix-brand = birdhouse
phoenix-title = PHOENIX
phoenix-description = A Python Web Application to interact with Web Processing Services
phoenix-theme = default
phoenix-docs = https://pyramid-phoenix.readthedocs.org/en/latest

# phoenix admin password
phoenix-password = qwerty
## generate secret
# python -c "import os; print(''.join('%02x' % ord(x) for x in os.urandom(16)))"
phoenix-secret = d5e8417934247ccb6cdbdb5144e3b130
